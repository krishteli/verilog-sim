{
  "name": "verilog-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based Verilog simulator and visualizer",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "record-demo": "node scripts/record-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "elkjs": "^0.9.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
